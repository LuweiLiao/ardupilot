# AI-assisted SITL-only profile for the ROS 2 powerline_perching model.
# Existing ArduRotorNormPlugin remaps X motors [0, 3, 1, 2].
FRAME_CLASS 1
FRAME_TYPE 1
MOT_THST_EXPO 0
MOT_THST_HOVER 0.635
MOT_HOVER_LEARN 0
MOT_SPIN_MIN 0.10
MOT_SPIN_ARM 0.05
ATC_RAT_RLL_P 0.12
ATC_RAT_RLL_I 0.12
ATC_RAT_RLL_D 0.003
ATC_RAT_PIT_P 0.12
ATC_RAT_PIT_I 0.12
ATC_RAT_PIT_D 0.003
ATC_RAT_YAW_P 0.12
ATC_RAT_YAW_I 0.02
PILOT_SPEED_UP 100
PILOT_SPEED_DN 60
LOIT_SPEED 100
LAND_SPEED 20
DISARM_DELAY 3
LOG_DISARMED 1
LOG_BACKEND_TYPE 1
SIM_SPEEDUP 1
RC_OVERRIDE_TIME 2
GUID_TIMEOUT 1
