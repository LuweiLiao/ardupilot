include ../Pogo-CANGPS/hwdef.dat

undef CAN_APP_NODE_NAME
define CAN_APP_NODE_NAME "pogo.cangps"

PA0 TIM2_CH1 TIM2 PWM(1)

define HAL_PERIPH_NEOPIXEL_COUNT_WITHOUT_NOTIFY 4
define HAL_PERIPH_NEOPIXEL_CHAN_WITHOUT_NOTIFY 0
define AP_PERIPH_NEOPIXEL_POGO_CANRGB_ENABLED

COMPASS QMC5883P I2C:0:0x2C true  ROTATION_NONE
define AP_COMPASS_QMC5883P_ENABLED 1

undef PB6 
undef PB7
PA9 USART1_TX USART1
PA10 USART1_RX USART1

undef I2C2
undef PB10
undef PB11
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
I2C_ORDER I2C1
